{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (gcc/clang, ASan+UBSan)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_FEATURES": "server;mesh;mls;tests",
                "FB_ENABLE_SANITIZERS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-release",
            "inherits": "linux-debug",
            "displayName": "Linux Release",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "FB_ENABLE_SANITIZERS": "OFF"
            }
        },
        {
            "name": "win-msvc-release",
            "displayName": "Windows MSVC Release (vcpkg)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/win-msvc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_FEATURES": "server;mesh",
                "FB_BUILD_DESKTOP_CLIENT": "OFF",
                "FB_BUILD_SERVER": "ON",
                "FB_BUILD_TOOLS": "ON",
                "FB_BUILD_TESTS": "OFF",
                "FB_ENABLE_SANITIZERS": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "win-msvc-release-mls",
            "displayName": "Windows MSVC Release + MLS (vendored mlspp)",
            "inherits": "win-msvc-release",
            "binaryDir": "${sourceDir}/build/win-msvc-release-mls",
            "cacheVariables": {
                "VCPKG_MANIFEST_FEATURES": "server;mesh;mls",
                "FB_FEATURE_MLS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux-debug",   "configurePreset": "linux-debug" },
        { "name": "linux-release", "configurePreset": "linux-release" },
        {
            "name": "win-msvc-release",
            "configurePreset": "win-msvc-release",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "win-msvc-release-mls",
            "configurePreset": "win-msvc-release-mls",
            "configuration": "RelWithDebInfo"
        }
    ],
    "testPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "win-msvc-release",
            "configurePreset": "win-msvc-release",
            "configuration": "RelWithDebInfo",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        }
    ]
}
